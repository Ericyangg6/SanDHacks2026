# Copy to .env (repo root) and fill in. Never commit .env.

ANTHROPIC_API_KEY=

# Bright Data (M2 scraping)
BRIGHTDATA_API=
BRIGHTDATA_UNLOCKER_ZONE=

# Mastra Platform
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# ElevenLabs voice agent (see agent/README.md)
ELEVENLABS_API_KEY=
# printed by `npm run el:sync`
ELEVENLABS_AGENT_ID=
# printed by `npm run el:import-number`
ELEVENLABS_PHONE_NUMBER_ID=
# from the post-call webhook in the ElevenLabs dashboard
ELEVENLABS_WEBHOOK_SECRET=
# optional; defaults to the voice in agent/agent.config.ts
ELEVENLABS_VOICE_ID=
# any long random string (openssl rand -hex 32); ElevenLabs sends it on tool calls
EL_TOOL_SECRET=
# public URL of apps/api (ngrok during dev), no trailing slash
PUBLIC_API_URL=

GEMINI_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +16195551234
TWILIO_PHONE_NUMBER=
# public URL for Twilio webhooks (M4)
PUBLIC_BASE_URL=
# any long random string (openssl rand -hex 32); the dashboard's mock-alert button sends it as "Authorization: Bearer <secret>" (M4)
M4_ALERT_SECRET=

# Phone hashing (contracts.md); same value for the whole team
PHONE_SALT=

# NWS API requires a User-Agent with contact info, e.g. "shade (team@example.com)"
NWS_USER_AGENT=

# Neon
NEON_API_KEY=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=

CONTEXT_DEV_API_KEY=
